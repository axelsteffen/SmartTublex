<?xml version="1.0" encoding="utf-8"?>
<!-- Stub manifest for AGP compile only. The TV APK is produced by packageWrapperApk. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".SmartTublexApplication"
        android:allowBackup="true"
        android:label="SmartTublex"
        android:supportsRtl="true">
        <activity
            android:name=".SmartTublexSplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ImmichImageViewerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
